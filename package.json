{
  "name": "sigpro",
  "version": "2.0.10",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "NatxoCC",
    "email": "sigpro@natxocc.com",
    "url": "https://sigpro.natxocc.com"
  },
  "main": "./dist/sigpro.js",
  "module": "./dist/sigpro.js",
  "unpkg": "./dist/sigpro.js",
  "jsdelivr": "./dist/sigpro.js",
  "types": "./sigpro.d.ts",
  "exports": {
    ".": {
      "types": "./sigpro.d.ts",
      "import": "./dist/sigpro.js",
      "default": "./dist/sigpro.js"
    },
    "./grid": {
      "import": "./dist/sigpro.grid.js",
      "default": "./dist/sigpro.grid.js"
    },
    "./editor": {
      "import": "./dist/sigpro.editor.js",
      "default": "./dist/sigpro.editor.js"
    },
    "./chart": {
      "import": "./dist/sigpro.chart.js",
      "default": "./dist/sigpro.chart.js"
    },
    "./calendar": {
      "import": "./dist/sigpro.calendar.js",
      "default": "./dist/sigpro.calendar.js"
    },
    "./vite": {
      "import": "./dist/sigpro.vite.js",
      "default": "./dist/sigpro.vite.js"
    },
    "./hmr": {
      "import": "./dist/sigpro.hmr.js",
      "default": "./dist/sigpro.hmr.js"
    },
    "./utils": {
      "import": "./dist/sigpro.utils.js",
      "default": "./dist/sigpro.utils.js"
    },
    "./pdf": {
      "import": "./dist/sigpro.pdf.js",
      "default": "./dist/sigpro.pdf.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "sigpro.d.ts"
  ],
  "homepage": "https://sigpro.natxocc.com/#/",
  "repository": {
    "type": "git",
    "url": "https://github.com/natxocc/sigpro"
  },
  "bugs": {
    "url": "https://github.com/natxocc/sigpro/issues",
    "email": "sigpro@natxocc.com"
  },
  "scripts": {
    "del": "bun pm cache rm && rm -f bun.lockb && rm -f bun.lock",
    "clean": "rm -rf dist docs/*.js",
    "prebuild": "bun run clean",
    "build:core": "bun build ./src/sigpro.js --bundle --outfile=./dist/sigpro.js --format=esm --minify",
    "build:utils": "bun build ./src/sigpro.utils.js --bundle --outfile=./dist/sigpro.utils.js --format=esm --minify",
    "build:grid": "bun build ./src/sigpro.grid.js --bundle --outfile=./dist/sigpro.grid.js --format=esm --minify",
    "build:chart": "bun build ./src/sigpro.chart.js --bundle --outfile=./dist/sigpro.chart.js --format=esm --minify",
    "build:calendar": "bun build ./src/sigpro.calendar.js --bundle --outfile=./dist/sigpro.calendar.js --format=esm --minify",
    "build:editor": "bun build ./src/sigpro.editor.js --bundle --outfile=./dist/sigpro.editor.js --format=esm --minify",
    "build:ui": "bun build ./src/sigpro.ui.js --bundle --outfile=./dist/sigpro.ui.js --format=esm --external ./src/sigpro.js --minify",
    "build:vite": "bun build ./src/sigpro.vite.js --bundle --outfile=./dist/sigpro.vite.js --format=esm --external fs --external path --minify",
    "build:hmr": "bun build ./src/sigpro.hmr.js --bundle --outfile=./dist/sigpro.hmr.js --format=esm --external fs --external path --minify",
    "build:convert": "bun build ./src/sigpro.convert.js --bundle --outfile=./dist/sigpro.convert.js --format=esm --minify",
    "build:pdf": "bun build ./src/sigpro.pdf.js --bundle --outfile=./dist/sigpro.pdf.js --format=esm --minify",
    "build": "mkdir -p docs && bun run build:core && bun run build:utils && bun run build:grid && bun run build:chart && bun run build:calendar && bun run build:editor && bun run build:ui && bun run build:vite && bun run build:convert && bun run build:pdf && cp ./dist/*.js ./docs/",
    "docs": "bun x serve docs"
  },
  "devDependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@iconify/json": "^2.2.557",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/cli": "^4.3.5",
    "ag-grid-community": "^35.3.1",
    "ag-grid-enterprise": "^35.3.1",
    "daisyui": "^5.8.1",
    "highcharts": "^13.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "tailwindcss": "^4.3.5"
  },
  "keywords": [
    "signals",
    "reactivity",
    "reactive",
    "pure",
    "vanilla",
    "js",
    "ui",
    "dom",
    "state",
    "frontend",
    "spa",
    "lightweight",
    "sigpro"
  ]
}