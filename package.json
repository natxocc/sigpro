{
  "name": "sigpro",
  "version": "2.1.6",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "NatxoCC",
    "email": "sigpro@natxocc.com",
    "url": "https://sigpro.natxocc.com"
  },
  "main": "./src/sigpro.js",
  "module": "./src/sigpro.js",
  "types": "./sigpro.d.ts",
  "exports": {
    ".": {
      "types": "./sigpro.d.ts",
      "import": "./src/sigpro.js",
      "default": "./src/sigpro.js"
    },
    "./router": {
      "types": "./sigpro.d.ts",
      "import": "./src/sigpro.router.js",
      "default": "./src/sigpro.router.js"
    },
    "./drag": {
      "types": "./sigpro.d.ts",
      "import": "./src/sigpro.drag.js",
      "default": "./src/sigpro.drag.js"
    },
    "./lang": {
      "types": "./sigpro.d.ts",
      "import": "./src/sigpro.lang.js",
      "default": "./src/sigpro.lang.js"
    },
    "./db": {
      "types": "./sigpro.d.ts",
      "import": "./src/sigpro.db.js",
      "default": "./src/sigpro.db.js"
    },
    "./vite": {
      "types": "./sigpro.d.ts",
      "import": "./src/sigpro.vite.js",
      "default": "./src/sigpro.vite.js"
    }
  },
  "files": [
    "src/",
    "sigpro.d.ts"
  ],
  "homepage": "https://sigpro.natxocc.com/#/",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/natxocc/sigpro"
  },
  "bugs": {
    "url": "https://github.com/natxocc/sigpro/issues",
    "email": "sigpro@natxocc.com"
  },
  "scripts": {
    "docs:sync": "mkdir -p docs/src && cp src/*.js docs/src/",
    "docs": "bun run docs:sync && bun x serve docs"
  },
  "keywords": [
    "signals",
    "reactivity",
    "reactive",
    "pure",
    "vanilla",
    "js",
    "ui",
    "dom",
    "state",
    "frontend",
    "spa",
    "lightweight",
    "sigpro"
  ]
}
